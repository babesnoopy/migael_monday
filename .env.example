# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file — it's already in .gitignore.

# LINE Bot (LINE Developers Console)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Babeb's LINE userId (for the personal daily summary)
BABE_USER_ID=

# Comma-separated LINE userIds allowed to 1:1 chat with Migael personally.
# Anyone else who adds her gets a polite "team-only" message instead.
# Defaults to just BABE_USER_ID if left blank.
ALLOWED_PERSONAL_USER_IDS=

# Claude AI (Anthropic Console)
ANTHROPIC_API_KEY=

# Google OAuth (Google Cloud Console — OAuth client credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:9873/oauth2callback
GOOGLE_REFRESH_TOKEN=

# Server
PORT=3000
PUBLIC_BASE_URL=https://your-railway-app.up.railway.app
